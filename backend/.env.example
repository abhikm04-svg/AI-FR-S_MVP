# Direct Postgres connection string (Supabase Project Settings -> Database ->
# Connection string). NOT the SUPABASE_URL/anon-key REST pair used elsewhere
# in this repo -- this is a raw Postgres DSN, needed by the ingestion
# pipeline, repositories, and the LangGraph checkpointer.
SUPABASE_DB_URL=postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres
